{
  "name": "makeshift",
  "productName": "Makeshift",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": ".build/host/main.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run build:native && vite --host 127.0.0.1",
    "build": "npm run build:native && vite build && tsc -p tsconfig.host.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "biome check package.json tsconfig.json tsconfig.host.json tsconfig.test.json vite.config.ts forge.config.js packaging biome.json scripts tests src",
    "format": "biome check --write package.json tsconfig.json tsconfig.host.json tsconfig.test.json vite.config.ts forge.config.js packaging biome.json scripts tests src",
    "test": "node scripts/clean-tests.mjs && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .cache/sketch-tests/tests/*.test.js",
    "test:ui": "node tests/ui.mjs",
    "test:current-tools": "node tests/current-tools-ui.mjs",
    "test:booleans": "node tests/boolean-collection-ui.mjs",
    "test:setup": "node --test tests/sdk-provenance.mjs tests/ui-runtime-selection.mjs tests/worktree-dependencies.mjs",
    "test:selection-history": "node tests/selection-history-ui.mjs",
    "test:reconnection": "node tests/boundary-reconnection-ui.mjs",
    "test:edge-move": "node tests/edge-move-ui.mjs",
    "test:face-move": "node tests/face-move-ui.mjs",
    "test:electron": "node tests/electron.mjs",
    "setup:native": "node scripts/setup-native.mjs",
    "build:native": "node scripts/build-native.mjs",
    "setup:kernel": "node scripts/setup-kernel.mjs",
    "test:fixtures": "npm run build && node tests/fixtures.mjs",
    "postinstall": "node node_modules/electron/install.js && node scripts/prepare-pty.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "package:mac": "npm run build && npm run release:prepare && electron-forge package --platform=darwin --arch=arm64",
    "make:mac": "npm run build && npm run release:prepare && electron-forge make --platform=darwin --arch=arm64",
    "test:release": "node --test tests/release-metadata.mjs",
    "setup:mesh": "node scripts/setup-mesh.mjs",
    "build:wasm": "node scripts/web/build-wasm.mjs",
    "build:web": "npm run build:wasm && vite build --mode web && node scripts/web/notices.mjs",
    "preview:web": "vite preview --mode web --host 127.0.0.1",
    "test:web": "node tests/web-mode.mjs",
    "size:web": "node scripts/web/size.mjs",
    "release:web": "node scripts/web/release.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "ghostty-web": "0.4.0",
    "node-pty": "1.1.0",
    "qrcode": "1.5.4",
    "quickjs-emscripten-core": "0.32.0",
    "three": "0.186.0",
    "typescript": "7.0.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@types/node": "24.13.4",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "electron": "44.3.0",
    "manifold-3d": "3.5.3",
    "playwright": "1.62.1",
    "postcss": "8.5.28",
    "postcss-value-parser": "4.2.0",
    "vite": "8.3.0"
  },
  "license": "LGPL-2.1-or-later",
  "description": "CAD with a coding agent",
  "config": {
    "forge": "./forge.config.js"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.2"
  }
}
