{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "package.json",
      "tsconfig*.json",
      "vite.config.ts",
      "forge.config.js",
      "packaging/*.json",
      "biome.json",
      "scripts/**",
      "tests/**",
      "src/**",
      "website/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": {
            "maxLines": 300,
            "skipBlankLines": false
          }
        }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 80,
            "skipBlankLines": false,
            "skipIifes": false
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
