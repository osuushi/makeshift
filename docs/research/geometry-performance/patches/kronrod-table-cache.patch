 #include <math_Vector.hxx>
 #include <TColStd_SequenceOfReal.hxx>
 
+namespace
+{
+// Immutable process-local tables for the six orders used by BRepGProp GK.
+// math_Vector already has 32-item stack storage; this saves table filling only.
+struct KronrodTables
+{
+  math_Vector points, weights, gaussPoints, gaussWeights;
+  Standard_Boolean valid;
+
+  explicit KronrodTables(const Standard_Integer order)
+      : points(1, order), weights(1, order),
+        gaussPoints(1, order / 2), gaussWeights(1, order / 2),
+        valid(math::KronrodPointsAndWeights(order, points, weights)
+              && math::OrderedGaussPointsAndWeights(order / 2, gaussPoints, gaussWeights))
+  {
+  }
+};
+
+const KronrodTables* cachedKronrodTables(const Standard_Integer order)
+{
+  switch (order)
+  {
+    case 5: { static const KronrodTables table(5); return &table; }
+    case 7: { static const KronrodTables table(7); return &table; }
+    case 9: { static const KronrodTables table(9); return &table; }
+    case 11: { static const KronrodTables table(11); return &table; }
+    case 13: { static const KronrodTables table(13); return &table; }
+    case 15: { static const KronrodTables table(15); return &table; }
+    default: return nullptr;
+  }
+}
+} // namespace
+
