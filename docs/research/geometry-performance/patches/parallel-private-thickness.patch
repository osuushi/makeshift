+// Serial request-local verification of known geometry roots/bases and copy aliases.
+class ThicknessGeometryOwnership {
+    struct Data;
+    std::unique_ptr<Data> data;
+public:
+    explicit ThicknessGeometryOwnership(const TopoDS_Shape& original);
+    ~ThicknessGeometryOwnership();
+    ThicknessGeometryOwnership(const ThicknessGeometryOwnership&) = delete;
+    ThicknessGeometryOwnership& operator=(const ThicknessGeometryOwnership&) = delete;
+    void addPrivateCopy(const TopoDS_Shape&);
+};
