+#include "parallel-thickness.h"
+#include "offset-thickness.h"
+#include "thickness-geometry-ownership.h"
+#include <BRepBuilderAPI_Copy.hxx>
+#include <OSD_ThreadPool.hxx>
+#include <TopExp.hxx>
+#include <TopoDS.hxx>
+#include <exception>
+#include <cstdlib>
+#include <cstring>
+#include <cstdio>
+#include <locale>
+#include <sstream>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+struct Worker {
+    TopoDS_Shape body;
+    TopTools_IndexedMapOfShape faces;
+    std::unique_ptr<OffsetThicknessContext> context;
+
+    Worker(const TopoDS_Shape& original, const TopTools_IndexedMapOfShape& originalFaces) {
+        // All copies finish serially before any worker performs exact queries.
+        BRepBuilderAPI_Copy copy(original, true, false);
+        if (!copy.IsDone()) throw std::runtime_error("Private thickness copy failed");
+        body = copy.Shape();
+        TopTools_IndexedMapOfShape bodyFaces;
+        TopExp::MapShapes(body, TopAbs_FACE, bodyFaces);
+        if (bodyFaces.Extent() != originalFaces.Extent())
+            throw std::runtime_error("Private thickness copy changed face count");
+        for (int i = 1; i <= originalFaces.Extent(); ++i) {
+            const auto& source = originalFaces(i);
+            const auto mapped = copy.ModifiedShape(source).Oriented(source.Orientation());
+            if (mapped.ShapeType() != TopAbs_FACE || !bodyFaces.Contains(mapped)
+                || !mapped.Location().IsEqual(source.Location()) || faces.Add(mapped) != i)
+                throw std::runtime_error("Private thickness face correspondence failed");
+        }
+        context = std::make_unique<OffsetThicknessContext>(body);
+    }
+};
+struct Formatting {
+    std::ios_base::fmtflags flags;
+    std::streamsize precision;
+    std::locale locale;
+    char fill;
+    explicit Formatting(const std::ostream& source)
+        : flags(source.flags()), precision(source.precision()), locale(source.getloc()), fill(source.fill()) {}
+    void apply(std::ostringstream& output) const {
+        output.flags(flags);
+        output.precision(precision);
+        output.imbue(locale);
+        output.fill(fill);
+    }
+};
+}
+
+struct ParallelThickness::Data {
+    std::vector<std::string> payloads;
+    std::vector<std::exception_ptr> failures;
+    explicit Data(int count) : payloads(count), failures(count) {}
+};
+
+ParallelThickness::ParallelThickness(const TopoDS_Shape& body,
+                                     const TopTools_IndexedMapOfShape& faces,
+                                     const std::ostream& format) {
+    const char* configured = std::getenv("MAKESHIFT_KERNEL_PRIVATE_THICKNESS");
+    const char* tracing = std::getenv("MAKESHIFT_KERNEL_PRIVATE_THICKNESS_TRACE");
+    const bool trace = tracing && std::strcmp(tracing, "1") == 0;
+    const bool serial = configured && std::strcmp(configured, "serial") == 0;
+    const bool parallel = configured && (std::strcmp(configured, "parallel") == 0
+                                        || std::strcmp(configured, "1") == 0);
+    const auto& pool = OSD_ThreadPool::DefaultPool();
+    if ((!serial && !parallel) || faces.Extent() < 16 || (parallel && !pool->HasThreads())) return;
+    try {
+        std::unique_ptr<OSD_ThreadPool::Launcher> launcher;
+        if (parallel) {
+            launcher = std::make_unique<OSD_ThreadPool::Launcher>(*pool, faces.Extent());
+            if (!launcher->HasThreads()) return;
+        }
+        const Formatting formatting(format); // Read all caller stream state serially.
+        ThicknessGeometryOwnership ownership(body);
+        auto prepared = std::make_unique<Data>(faces.Extent());
+        std::vector<std::unique_ptr<Worker>> workers;
+        const int workerCount = serial ? 1 : launcher->NbThreads();
+        workers.reserve(workerCount);
+        for (int i = 0; i < workerCount; ++i) {
+            workers.push_back(std::make_unique<Worker>(body, faces));
+            ownership.addPrivateCopy(workers.back()->body);
+        }
+        const auto compute = [&](int threadIndex, int faceIndex) {
+            try {
+                auto& worker = *workers.at(threadIndex);
+                std::ostringstream output;
+                formatting.apply(output);
+                presentOffsetThickness(output, TopoDS::Face(worker.faces(faceIndex + 1)),
+                                       worker.faces, *worker.context);
+                prepared->payloads[faceIndex] = output.str();
+            } catch (...) {
+                prepared->failures[faceIndex] = std::current_exception();
+            }
+        };
+        if (serial) for (int i = 0; i < faces.Extent(); ++i) compute(0, i);
+        else launcher->Perform(0, faces.Extent(), compute);
+        data = std::move(prepared);
+        if (trace) std::fprintf(stderr, "private-thickness active mode=%s faces=%d workers=%d\n",
+                                serial ? "serial" : "parallel", faces.Extent(), workerCount);
+    } catch (const std::exception& error) {
+        if (trace) std::fprintf(stderr, "private-thickness serial fallback: %s\n", error.what());
+        data.reset();
+    } catch (...) {
+        // Failed private setup adds no new geometric failure: use the original path.
+        // No worker task touches original body supports or the shared output stream.
+        if (trace) std::fputs("private-thickness serial fallback: non-std exception\n", stderr);
+        data.reset();
+    }
+}
+ParallelThickness::~ParallelThickness() = default;
+
+bool ParallelThickness::append(std::ostream& output, int faceIndex) const {
+    if (!data) return false;
+    if (faceIndex < 1 || faceIndex > int(data->payloads.size()))
+        throw std::runtime_error("Invalid private thickness face index");
+    const auto index = size_t(faceIndex - 1);
+    if (data->failures[index]) std::rethrow_exception(data->failures[index]);
+    output << data->payloads[index];
+    return true;
+}
