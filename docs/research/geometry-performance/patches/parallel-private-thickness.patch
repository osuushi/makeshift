+#pragma once
+#include <TopoDS_Shape.hxx>
+#include <TopTools_IndexedMapOfShape.hxx>
+#include <memory>
+#include <ostream>
+
+// Request-local exact thickness payloads only; original presentation stays serial.
+class ParallelThickness {
+    struct Data;
+    std::unique_ptr<Data> data;
+public:
+    ParallelThickness(const TopoDS_Shape&, const TopTools_IndexedMapOfShape&, const std::ostream&);
+    ~ParallelThickness();
+    ParallelThickness(const ParallelThickness&) = delete;
+    ParallelThickness& operator=(const ParallelThickness&) = delete;
+    // False means serial fallback; deferred face failures replay here in original order.
+    bool append(std::ostream&, int faceIndex) const;
+};
