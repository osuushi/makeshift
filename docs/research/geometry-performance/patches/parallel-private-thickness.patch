+#include "thickness-geometry-ownership.h"
+#include <BRep_CurveRepresentation.hxx>
+#include <BRep_TEdge.hxx>
+#include <BRep_TFace.hxx>
+#include <Geom_BSplineCurve.hxx>
+#include <Geom_BSplineSurface.hxx>
+#include <Geom_BezierCurve.hxx>
+#include <Geom_BezierSurface.hxx>
+#include <Geom_Circle.hxx>
+#include <Geom_ConicalSurface.hxx>
+#include <Geom_CylindricalSurface.hxx>
+#include <Geom_Ellipse.hxx>
+#include <Geom_Hyperbola.hxx>
+#include <Geom_Line.hxx>
+#include <Geom_OffsetCurve.hxx>
+#include <Geom_OffsetSurface.hxx>
+#include <Geom_Parabola.hxx>
+#include <Geom_Plane.hxx>
+#include <Geom_RectangularTrimmedSurface.hxx>
+#include <Geom_SphericalSurface.hxx>
+#include <Geom_SurfaceOfLinearExtrusion.hxx>
+#include <Geom_SurfaceOfRevolution.hxx>
+#include <Geom_ToroidalSurface.hxx>
+#include <Geom_TrimmedCurve.hxx>
+#include <Geom2d_BSplineCurve.hxx>
+#include <Geom2d_BezierCurve.hxx>
+#include <Geom2d_Circle.hxx>
+#include <Geom2d_Ellipse.hxx>
+#include <Geom2d_Hyperbola.hxx>
+#include <Geom2d_Line.hxx>
+#include <Geom2d_Parabola.hxx>
+#include <Geom2d_TrimmedCurve.hxx>
+#include <TopExp_Explorer.hxx>
+#include <stdexcept>
+#include <unordered_set>
+
+namespace {
+using Geometry = std::unordered_set<const Standard_Transient*>;
+template <typename T> bool exact(const Handle(T)& geometry, const Handle(Standard_Type)& type) {
+    return geometry->DynamicType() == type;
+}
+template <typename T> bool enter(const Handle(T)& geometry, Geometry& values, int depth) {
+    if (geometry.IsNull()) return false;
+    if (depth > 32) throw std::runtime_error("Private thickness geometry nesting exceeds guard");
+    return values.insert(geometry.get()).second;
+}
+void curve(const Handle(Geom_Curve)& value, Geometry& values, int depth) {
+    if (!enter(value, values, depth)) return;
+    if (exact(value, STANDARD_TYPE(Geom_TrimmedCurve)))
+        curve(Handle(Geom_TrimmedCurve)::DownCast(value)->BasisCurve(), values, depth + 1);
+    else if (exact(value, STANDARD_TYPE(Geom_OffsetCurve)))
+        curve(Handle(Geom_OffsetCurve)::DownCast(value)->BasisCurve(), values, depth + 1);
+    else if (!exact(value, STANDARD_TYPE(Geom_Line)) && !exact(value, STANDARD_TYPE(Geom_Circle))
+             && !exact(value, STANDARD_TYPE(Geom_Ellipse)) && !exact(value, STANDARD_TYPE(Geom_Hyperbola))
+             && !exact(value, STANDARD_TYPE(Geom_Parabola)) && !exact(value, STANDARD_TYPE(Geom_BSplineCurve))
+             && !exact(value, STANDARD_TYPE(Geom_BezierCurve)))
+        throw std::runtime_error("Unsupported private thickness 3D support");
+}
+void curve2d(const Handle(Geom2d_Curve)& value, Geometry& values, int depth) {
+    if (!enter(value, values, depth)) return;
+    if (exact(value, STANDARD_TYPE(Geom2d_TrimmedCurve)))
+        curve2d(Handle(Geom2d_TrimmedCurve)::DownCast(value)->BasisCurve(), values, depth + 1);
+    // Geom2d_OffsetCurve deliberately fails closed: pinned Copy can share its basis.
+    else if (!exact(value, STANDARD_TYPE(Geom2d_Line)) && !exact(value, STANDARD_TYPE(Geom2d_Circle))
+             && !exact(value, STANDARD_TYPE(Geom2d_Ellipse)) && !exact(value, STANDARD_TYPE(Geom2d_Hyperbola))
+             && !exact(value, STANDARD_TYPE(Geom2d_Parabola)) && !exact(value, STANDARD_TYPE(Geom2d_BSplineCurve))
+             && !exact(value, STANDARD_TYPE(Geom2d_BezierCurve)))
+        throw std::runtime_error("Unsupported private thickness 2D support");
+}
+void surface(const Handle(Geom_Surface)& value, Geometry& values, int depth) {
+    if (!enter(value, values, depth)) return;
+    if (exact(value, STANDARD_TYPE(Geom_RectangularTrimmedSurface)))
+        surface(Handle(Geom_RectangularTrimmedSurface)::DownCast(value)->BasisSurface(), values, depth + 1);
+    else if (exact(value, STANDARD_TYPE(Geom_OffsetSurface)))
+        surface(Handle(Geom_OffsetSurface)::DownCast(value)->BasisSurface(), values, depth + 1);
+    else if (exact(value, STANDARD_TYPE(Geom_SurfaceOfLinearExtrusion)))
+        curve(Handle(Geom_SurfaceOfLinearExtrusion)::DownCast(value)->BasisCurve(), values, depth + 1);
+    else if (exact(value, STANDARD_TYPE(Geom_SurfaceOfRevolution)))
+        curve(Handle(Geom_SurfaceOfRevolution)::DownCast(value)->BasisCurve(), values, depth + 1);
+    else if (!exact(value, STANDARD_TYPE(Geom_Plane)) && !exact(value, STANDARD_TYPE(Geom_CylindricalSurface))
+             && !exact(value, STANDARD_TYPE(Geom_ConicalSurface)) && !exact(value, STANDARD_TYPE(Geom_SphericalSurface))
+             && !exact(value, STANDARD_TYPE(Geom_ToroidalSurface)) && !exact(value, STANDARD_TYPE(Geom_BSplineSurface))
+             && !exact(value, STANDARD_TYPE(Geom_BezierSurface)))
+        throw std::runtime_error("Unsupported private thickness surface support");
+}
+Geometry collect(const TopoDS_Shape& body) {
+    Geometry values;
+    for (TopExp_Explorer e(body, TopAbs_FACE); e.More(); e.Next()) {
+        const auto face = Handle(BRep_TFace)::DownCast(e.Current().TShape());
+        if (face.IsNull()) throw std::runtime_error("Unsupported private thickness face topology");
+        surface(face->Surface(), values, 0);
+    }
+    for (TopExp_Explorer e(body, TopAbs_EDGE); e.More(); e.Next()) {
+        const auto edge = Handle(BRep_TEdge)::DownCast(e.Current().TShape());
+        if (edge.IsNull()) throw std::runtime_error("Unsupported private thickness edge topology");
+        for (const auto& representation : edge->Curves()) {
+            if (representation->IsCurve3D()) curve(representation->Curve3D(), values, 0);
+            else if (representation->IsCurveOnSurface()) {
+                surface(representation->Surface(), values, 0);
+                curve2d(representation->PCurve(), values, 0);
+                if (representation->IsCurveOnClosedSurface()) curve2d(representation->PCurve2(), values, 0);
+            } else if (representation->IsRegularity()) {
+                surface(representation->Surface(), values, 0);
+                surface(representation->Surface2(), values, 0);
+            } else if (representation->IsPolygonOnSurface()) surface(representation->Surface(), values, 0);
+            else if (!representation->IsPolygon3D() && !representation->IsPolygonOnTriangulation())
+                throw std::runtime_error("Unsupported private thickness edge representation");
+        }
+    }
+    return values;
+}
+}
+struct ThicknessGeometryOwnership::Data { Geometry seen; };
+ThicknessGeometryOwnership::ThicknessGeometryOwnership(const TopoDS_Shape& original)
+    : data(std::make_unique<Data>()) { data->seen = collect(original); }
+ThicknessGeometryOwnership::~ThicknessGeometryOwnership() = default;
+void ThicknessGeometryOwnership::addPrivateCopy(const TopoDS_Shape& copy) {
+    const auto values = collect(copy);
+    for (const auto* value : values) if (data->seen.contains(value))
+        throw std::runtime_error("Private thickness geometry copy shares support handle");
+    data->seen.insert(values.begin(), values.end());
+}
