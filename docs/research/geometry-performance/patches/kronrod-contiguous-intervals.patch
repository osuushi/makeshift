+#include <Standard_OutOfRange.hxx>
+#include <vector>
+
+namespace
+{
+// Research-only storage adapter. Preserve the original one-based access and
+// insertion semantics, including its checked invalid-zero-index exception.
+class KronrodRealSequence
+{
+public:
+  KronrodRealSequence() { values.reserve(32); }
+  Standard_Integer Length() const { return static_cast<Standard_Integer>(values.size()); }
+  void Append(const Standard_Real value) { values.push_back(value); }
+  Standard_Real& operator()(const Standard_Integer index)
+  {
+    Standard_OutOfRange_Raise_if(index <= 0 || index > Length(),
+                                 "NCollection_Sequence::ChangeValue");
+    return values[static_cast<std::size_t>(index - 1)];
+  }
+  void InsertAfter(const Standard_Integer index, const Standard_Real value)
+  {
+    Standard_OutOfRange_Raise_if(index < 0 || index > Length(),
+                                 "NCollection_Sequence::InsertAfter");
+    values.insert(values.begin() + index, value);
+  }
+private:
+  std::vector<Standard_Real> values;
+};
+} // namespace
 
