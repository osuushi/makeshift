 #include <BRep_Tool.hxx>
 #include <TopoDS.hxx>
 #include <GeomAPI_ProjectPointOnCurve.hxx>
+#include <GeomAdaptor_Curve.hxx>
+
+namespace
+{
+struct RayLineScratch
+{
+  Handle(Geom_Line) line;
+  Handle(GeomAdaptor_Curve) curve;
+  bool busy = false;
+};
+
+// Lives before the local HICS, so reuse stays disabled through its destruction.
+// No intersector class/header/layout changes; each worker has separate scratch.
+class RayLineLease
+{
+public:
+  explicit RayLineLease(const bool enabled)
+  {
+    if (!enabled) return;
+    static thread_local RayLineScratch storage;
+    if (storage.busy) return;
+    if (!storage.curve.IsNull())
+    {
+      // The only expected owners are scratch.curve and scratch.line+curve.
+      // A retained adaptor or shallow copy retaining the line forbids mutation.
+      if (storage.curve->GetRefCount() != 1 || storage.line.IsNull()
+          || storage.line->GetRefCount() != 2) return;
+    }
+    else if (!storage.line.IsNull()) return;
+    storage.busy = true;
+    scratch = &storage;
+  }
+  ~RayLineLease() { if (scratch) scratch->busy = false; }
+  RayLineLease(const RayLineLease&) = delete;
+  RayLineLease& operator=(const RayLineLease&) = delete;
+  bool Reusable() const { return scratch != nullptr; }
+  Handle(GeomAdaptor_Curve) Load(const gp_Lin& line)
+  {
+    if (scratch->curve.IsNull())
+    {
+      scratch->line = new Geom_Line(line);
+      scratch->curve = new GeomAdaptor_Curve(scratch->line);
+    }
+    else
+    {
+      // Load of the same handle alone may retain type-specific preparation.
+      scratch->curve->Reset();
+      scratch->line->SetLin(line);
+      scratch->curve->Load(scratch->line);
+    }
+    return scratch->curve;
+  }
+private:
+  RayLineScratch* scratch = nullptr;
+};
+} // namespace
 
