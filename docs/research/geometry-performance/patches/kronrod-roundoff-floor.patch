+Standard_Boolean roundoffGKRule(math_Function& theFunction,
+                               const Standard_Real theLower,
+                               const Standard_Real theUpper,
+                               const math_Vector& theGaussP,
+                               const math_Vector& theGaussW,
+                               const math_Vector& theKronrodP,
+                               const math_Vector& theKronrodW,
+                               Standard_Real& theValue,
+                               Standard_Real& theError,
+                               Standard_Real& theFloor);
+
+Standard_Boolean roundoffLimited(const Standard_Real theValue,
+                                const Standard_Real theError,
+                                const Standard_Real theFloor,
+                                const Standard_Real theTolerance)
+{
+  const Standard_Real aTarget = Abs(theValue) > Epsilon(1.)
+                                 ? theTolerance * Abs(theValue) : theTolerance;
+  return std::isfinite(aTarget) && std::isfinite(theError) && std::isfinite(theFloor)
+         && aTarget < theFloor && 0.5 * theError <= theFloor;
+}
