+// Identity allocation is shared, but no coefficient cache is shared by threads.
+std::uint64_t NextFixedVGeneration()
+{
+  static std::atomic<std::uint64_t> aNext(1);
+  std::uint64_t aGeneration = aNext.load(std::memory_order_relaxed);
+  do
+  {
+    if (aGeneration == std::numeric_limits<std::uint64_t>::max())
+      throw Standard_ProgramError("Fixed-V cache generation exhausted");
+  }
+  while (!aNext.compare_exchange_weak(aGeneration,
+                                      aGeneration + 1,
+                                      std::memory_order_relaxed,
+                                      std::memory_order_relaxed));
+  return aGeneration;
+}
+
+struct FixedVPartial
+{
+  const BSplSLib_Cache* Owner = NULL;
+  std::uint64_t Generation = 0;
+  Standard_Real Parameter = 0.0;
+  Standard_Boolean Valid = Standard_False;
+  std::vector<Standard_Real> Coefficients;
+};
