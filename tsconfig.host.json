{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": ".build/host",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/main.ts",
    "src/preload.cts",
    "src/preview-preload.cts",
    "src/settings-preload.cts",
    "src/agent-cli/main.ts",
    "src/agent-cli/script-worker.ts",
    "src/agent-cli/view-worker.ts"
  ]
}
